<div class="page-container admin-page">
  <div class="page-header">
    <h1 class="page-title">Sandbox tokens</h1>
    <%= link_to "New token", new_admin_sandbox_token_path, class: "btn-primary" %>
  </div>

  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Label</th>
          <th>URL</th>
          <th>Languages</th>
          <th>Valid from (Argentina)</th>
          <th>Expires (Argentina)</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @sandbox_access_tokens.each do |token| %>
          <tr>
            <td><%= token.label.presence || "-" %></td>
            <td>
              <code class="admin-token-url"><%= sandbox_token_url(token.token) %></code>
            </td>
            <td><%= token.language_names.presence || "-" %></td>
            <td><%= token.valid_from_in_argentina.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= token.expires_at_in_argentina.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <span class="status-badge <%= token.status_label %>"><%= token.status_label %></span>
            </td>
            <td>
              <% if token.expirable? %>
                <div class="admin-actions">
                  <%= link_to "Edit", edit_admin_sandbox_token_path(token), class: "btn-small btn-secondary" %>
                  <%= button_to "Expire", expire_admin_sandbox_token_path(token), method: :post,
                      class: "btn-small btn-danger",
                      data: { turbo: false } %>
                </div>
              <% else %>
                -
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @sandbox_access_tokens.empty? %>
      <div class="empty-state">
        <div class="empty-icon">🔑</div>
        <div class="empty-title">No sandbox tokens yet</div>
        <div class="empty-text">Create a token to share sandbox-only access</div>
      </div>
    <% end %>
  </div>
</div>
