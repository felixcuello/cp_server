<% content_for(:title) { "Sandbox | UP" } %>
<% if @sandbox_access_token.present? %>
  <% content_for(:head) do %>
    <meta name="robots" content="noindex, nofollow">
  <% end %>
<% end %>

<div class="page-container">
  <% if @sandbox_access_token.present? %>
    <div class="sandbox-token-countdown"
         data-controller="sandbox-token-countdown"
         data-sandbox-token-countdown-expires-at-value="<%= @sandbox_access_token.expires_at.to_i * 1000 %>">
      <span class="sandbox-token-countdown-label"><%= t('sandbox.time_remaining') %></span>
      <span class="sandbox-token-countdown-value">
        <span data-sandbox-token-countdown-target="hours">00</span>h
        <span data-sandbox-token-countdown-target="minutes">00</span>m
      </span>
    </div>
  <% end %>

  <div class="sandbox-container"
       data-controller="sandbox resize"
       data-sandbox-token-value="<%= @sandbox_access_token&.token %>"
       data-sandbox-locale-value="<%= I18n.locale %>"
       data-sandbox-missing-label-value="<%= t('sandbox.man_missing') %>"
       data-sandbox-languages-value="<%= @languages.map { |l| { id: l.id, name: l.name } }.to_json %>">

    <!-- Left Pane: Code Editor -->
    <div class="sandbox-left-pane" data-resize-target="leftPane">
      <div class="editor-section">
        <div class="editor-header">
          <div class="editor-header-left">
            <span style="font-weight: 600; color: var(--text-heading);"><%= t('sandbox.code') %></span>
            <select data-sandbox-target="languageSelect" data-action="change->sandbox#changeLanguage">
              <% @languages.each_with_index do |language, index| %>
                <option value="<%= language.id %>" data-lang="<%= language.name.downcase %>" <%= 'selected' if index == 0 %>>
                  <%= language.name %>
                </option>
              <% end %>
            </select>
          </div>
          <div class="editor-header-actions">
            <button class="btn-search" data-action="click->sandbox#openSearch" title="Search & Replace (Ctrl+F / Ctrl+H)">
              🔍
            </button>
            <% first_lang = @languages.first %>
            <button class="sandbox-man-button"
                    type="button"
                    data-sandbox-target="manButton"
                    data-action="click->sandbox#toggleMan"
                    title="man (Ctrl+Shift+M)"
                    <%= "hidden" unless first_lang && %w[c cpp].include?(language_class(first_lang.name)) %>>
              <%= t('sandbox.man') %>
            </button>
            <button class="btn-secondary" data-action="click->sandbox#resetCode">
              🔄 <%= t('sandbox.reset') %>
            </button>
          </div>
        </div>
        <div class="editor-container" data-sandbox-target="codeEditor"></div>
      </div>
    </div>

    <!-- Horizontal Resizer -->
    <div class="problem-split-resizer" data-resize-target="resizer"></div>

    <!-- Right Pane: Input + Run + Output (replaced by docs while man is open) -->
    <div class="sandbox-right-pane" data-resize-target="rightPane">

      <div class="sandbox-run-pane" data-sandbox-target="runPane">
        <!-- Input Section -->
        <div class="sandbox-input-section">
          <div class="sandbox-section-header">
            <span class="sandbox-section-title"><%= t('sandbox.input') %></span>
          </div>
          <div class="sandbox-input-editor" data-sandbox-target="inputEditor"></div>
        </div>

        <!-- Run Button Bar -->
        <div class="sandbox-run-bar">
          <button class="sandbox-run-button" data-action="click->sandbox#run" data-sandbox-target="runButton">
            <span class="run-icon">|▶</span> <span><%= t('sandbox.run') %></span>
          </button>
          <span class="sandbox-runtime" data-sandbox-target="runtime"></span>
        </div>

        <!-- Output Section -->
        <div class="sandbox-output-section">
          <div class="sandbox-section-header">
            <span class="sandbox-section-title"><%= t('sandbox.output') %></span>
            <span class="sandbox-status-badge" data-sandbox-target="statusBadge"></span>
          </div>
          <div class="sandbox-output" data-sandbox-target="output">
            <pre class="sandbox-output-content" data-sandbox-target="outputContent"><span class="sandbox-output-placeholder"><%= t('sandbox.output_placeholder') %></span></pre>
          </div>
        </div>
      </div>

      <div class="sandbox-docs-pane" hidden data-sandbox-target="docsPane">
        <div class="sandbox-section-header">
          <span class="sandbox-section-title"><%= t('sandbox.man_docs') %></span>
          <button type="button" class="sandbox-docs-close" data-action="click->sandbox#closeMan" aria-label="<%= t('sandbox.man_close') %>">
            x
          </button>
        </div>
        <div class="sandbox-docs-search">
          <input type="search"
                 class="sandbox-docs-search-input"
                 data-sandbox-target="manSearch"
                 data-action="input->sandbox#filterManPages"
                 placeholder="<%= t('sandbox.man_search') %>"
                 autocomplete="off">
        </div>
        <div class="sandbox-docs-split">
          <nav class="sandbox-docs-nav" data-sandbox-target="manNav"></nav>
          <div class="sandbox-docs-main">
            <div class="sandbox-docs-fallback" hidden data-sandbox-target="manFallback"><%= t('sandbox.man_english_fallback') %></div>
            <div class="sandbox-docs-page-title" data-sandbox-target="manTitle"></div>
            <div class="sandbox-docs-body" data-sandbox-target="manBody">
              <p class="sandbox-docs-placeholder"><%= t('sandbox.man_placeholder') %></p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Monaco Editor -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
<script>
  if (typeof require !== 'undefined') {
    require.config({
      paths: {
        vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs'
      }
    });

    window.monacoLoaded = new Promise((resolve) => {
      require(['vs/editor/editor.main'], function() {
        window.monacoReady = true;
        resolve();
      });
    });
  }
</script>
